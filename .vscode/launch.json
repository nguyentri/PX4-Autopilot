{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "rzv2hJlinkSerial",
            "type": "promptString",
            "description": "Exact J-Link serial number for the authorized RZ/V2H probe"
        }
    ],
    //Map usb to WSL2, run the following commands in Windows PowerShell as Administrator
    //usbipd list
    //usbipd bind --busid 1-4
    //usbipd attach --wsl --busid 1-4
    //usbipd detach --busid 1-4 // to detach the device from WSL2
    "configurations": [
        {
            "name": "IPC RZV2H CR8-0 (serial) — load & debug",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/platforms/nuttx/NuttX/nuttx/nuttx-ipcc-raw-cr8_0-serial.elf",
            "armToolchainPath": "/opt/arm-gnu-toolchain-13.2.Rel1/bin",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "svdFile": "${workspaceRoot}/rzv2h.svd",
            "servertype": "jlink",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServer",
            "serverArgs": ["-speed", "auto"],
            "device": "R9A09G057H44_R8_0",
            "showDevDebugOutput": "parsed",
            // Volatile RAM load + core-local start. NO monitor reset: the peer
            // CR8-1 image is resident and a reset is SoC-wide (see loadstart.gdb).
            // CR8-0 NSH console is on the serial UART (external picocom), not RTT.
            "overrideLaunchCommands": [
                "monitor halt",
                "load",
                "set $pc = __start",
                "set $cpsr = 0x1d3"
            ],
            "overrideResetCommands": [
                "monitor halt",
                "set $pc = __start",
                "set $cpsr = 0x1d3"
            ],
            "runToEntryPoint": "arm_boot",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "IPC RZV2H CR8-1 (RTT) — load & debug",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/platforms/nuttx/NuttX/nuttx/nuttx-ipcc-raw-cr8_1.elf",
            "armToolchainPath": "/opt/arm-gnu-toolchain-13.2.Rel1/bin",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "svdFile": "${workspaceRoot}/rzv2h.svd",
            "servertype": "jlink",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServer",
            "serverArgs": ["-speed", "auto"],
            "device": "R9A09G057H44_R8_1",
            "showDevDebugOutput": "parsed",
            // Same volatile RAM load, NO monitor reset (peer CR8-0 resident).
            "overrideLaunchCommands": [
                "monitor halt",
                "load",
                "set $pc = __start",
                "set $cpsr = 0x1d3"
            ],
            "overrideResetCommands": [
                "monitor halt",
                "set $pc = __start",
                "set $cpsr = 0x1d3"
            ],
            "runToEntryPoint": "arm_boot",
            // CR8-1 NSH console over SEGGER RTT; control block at 0x081E0000.
            "rttConfig": {
                "enabled": true,
                "address": "0x081E0000",
                "decoders": [
                    {
                        "label": "CR8-1 NSH",
                        "port": 0,
                        "type": "console"
                    }
                ]
            },
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "IPC RZV2H — load BOTH, attach CR8-0",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/platforms/nuttx/NuttX/nuttx/nuttx-ipcc-raw-cr8_0-serial.elf",
            "armToolchainPath": "/opt/arm-gnu-toolchain-13.2.Rel1/bin",
            "request": "attach",
            "type": "cortex-debug",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "svdFile": "${workspaceRoot}/rzv2h.svd",
            "servertype": "jlink",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServer",
            "serverArgs": ["-speed", "auto"],
            "device": "R9A09G057H44_R8_0",
            "showDevDebugOutput": "parsed",
            // preLaunchTask loads + verifies BOTH cores and frees the probe;
            // then attach to the already-running CR8-0 (no load, no reset).
            "preLaunchTask": "rzv2h-ipc-load-both",
            "overrideAttachCommands": [
                "monitor halt"
            ],
            "overrideResetCommands": [
                "monitor halt"
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "IPC RZV2H — load BOTH, attach CR8-1 (RTT)",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/platforms/nuttx/NuttX/nuttx/nuttx-ipcc-raw-cr8_1.elf",
            "armToolchainPath": "/opt/arm-gnu-toolchain-13.2.Rel1/bin",
            "request": "attach",
            "type": "cortex-debug",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "svdFile": "${workspaceRoot}/rzv2h.svd",
            "servertype": "jlink",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServer",
            "serverArgs": ["-speed", "auto"],
            "device": "R9A09G057H44_R8_1",
            "showDevDebugOutput": "parsed",
            "preLaunchTask": "rzv2h-ipc-load-both",
            "overrideAttachCommands": [
                "monitor halt"
            ],
            "overrideResetCommands": [
                "monitor halt"
            ],
            "rttConfig": {
                "enabled": true,
                "address": "0x081E0000",
                "decoders": [
                    {
                        "label": "CR8-1 NSH",
                        "port": 0,
                        "type": "console"
                    }
                ]
            },
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "IPC RZV2H — load BOTH (CR8-0 RTT), attach CR8-0 (RTT)",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/platforms/nuttx/NuttX/nuttx/nuttx-ipcc-raw-cr8_0.elf",
            "armToolchainPath": "/opt/arm-gnu-toolchain-13.2.Rel1/bin",
            "request": "attach",
            "type": "cortex-debug",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "svdFile": "${workspaceRoot}/rzv2h.svd",
            "servertype": "jlink",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServer",
            "serverArgs": ["-speed", "auto"],
            "device": "R9A09G057H44_R8_0",
            "showDevDebugOutput": "parsed",
            // Path A: drive the INITIATOR (CR8-0) over RTT with one probe.
            // preLaunchTask loads the CR8-0 RTT-console build + the CR8-1
            // responder, then attach to the already-running CR8-0 (no load, no
            // reset). CR8-1 boots headless and auto-echoes on /dev/ipcc1.
            // On this CR8-0 prompt run:
            //   ipctest --recover -d /dev/ipcc1
            //   ipctest --ping    -d /dev/ipcc1 -n 100 -s 64
            "preLaunchTask": "rzv2h-ipc-load-both-cr8_0-rtt",
            "overrideAttachCommands": [
                "monitor halt"
            ],
            "overrideResetCommands": [
                "monitor halt"
            ],
            // CR8-0 NSH console over SEGGER RTT; control block at 0x081A0000.
            "rttConfig": {
                "enabled": true,
                "address": "0x081A0000",
                "decoders": [
                    {
                        "label": "CR8-0 NSH",
                        "port": 0,
                        "type": "console"
                    }
                ]
            },
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "cwd": "${workspaceRoot}",
            "name": "Debug RZV2H CR8 (Core0)",
            //"executable": "${workspaceRoot}/build/renesas_rdk-rzv2h_sih/renesas_rdk-rzv2h_sih.elf",
            "executable": "${workspaceRoot}/build/renesas_rdk-rzv2h_demo/renesas_rdk-rzv2h_demo.elf",
            "armToolchainPath": "/opt/arm-gnu-toolchain-13.2.Rel1/bin",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "svdFile": "${workspaceRoot}/rzv2h.svd",
            "servertype": "jlink",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServer",
            "serverArgs": [
                "-speed", "15000"
            ],
            "device": "R9A09G057H44_R8_0",
            "showDevDebugOutput": "parsed",
            "overrideLaunchCommands": [
                "monitor halt",
                "monitor reset",
                "load",
                "set $pc = __start",
                "set $cpsr = 0x1d3"
            ],
            "overrideResetCommands": [
                "monitor halt",
                "monitor reset",
                "set $pc = __start",
                "set $cpsr = 0x1d3"
            ],
            "runToEntryPoint": "arm_boot",
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "rtt_0",
                        "port": 0,
                        "type": "console"
                    }
                ]
            },
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "Debug RZV2H CR8 (Core0, standalone NuttX)",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/platforms/nuttx/NuttX/nuttx/nuttx",
            "armToolchainPath": "/opt/arm-gnu-toolchain-13.2.Rel1/bin",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "svdFile": "${workspaceRoot}/rzv2h.svd",
            "servertype": "jlink",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServer",
            "serverArgs": [
                "-speed", "15000"
            ],
            "device": "R9A09G057H44_R8_0",
            "showDevDebugOutput": "parsed",
            "overrideLaunchCommands": [
                "monitor halt",
                "monitor reset",
                "load",
                "set $pc = __start",
                "set $cpsr = 0x1d3"
            ],
            "overrideResetCommands": [
                "monitor halt",
                "monitor reset",
                "set $pc = __start",
                "set $cpsr = 0x1d3"
            ],
            "runToEntryPoint": "arm_boot",
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "rtt_0",
                        "port": 0,
                        "type": "console"
                    }
                ]
            },
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "Debug RA8P1 CM85 (Core0)",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/renesas_evk-ra8p1_default/renesas_evk-ra8p1_default.elf",
            //"executable": "${workspaceRoot}/platforms/nuttx/NuttX/nuttx/nuttx",
            "armToolchainPath": "/opt/arm-gnu-toolchain-13.2.Rel1/bin",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "svdFile": "${workspaceRoot}/R7KA8P1AD.svd",
            "servertype": "jlink",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServer",
            "serverArgs": [
                "-speed", "15000"
            ],
            "device": "R7KA8P1KF_CPU0",
            "showDevDebugOutput": "parsed",
            "runToEntryPoint": "__start",
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "rtt_0",
                        "port": 0,
                        "type": "console"
                    }
                ]
            },
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "overrideLaunchCommands": [
                "monitor reset",
                "monitor halt",
                "load",
                // Enable to load the IO CM33 core binary
                //"add-symbol-file ${workspaceRoot}/build/renesas_evk-ra8p1-io-cm33_default/renesas_evk-ra8p1-io-cm33_default.elf",
                //"restore ${workspaceRoot}/build/renesas_evk-ra8p1-io-cm33_default/renesas_evk-ra8p1-io-cm33_default.bin binary 0x08000000",
                "monitor reset",
                "monitor halt"
            ],
            "preLaunchCommands": [
                "source ${workspaceFolder}/platforms/nuttx/Debug/PX4",
                "source ${workspaceFolder}/platforms/nuttx/Debug/NuttX",
                "set mem inaccessible-by-default off",
                "set print pretty"
            ]
        },
        {
            "name": "Debug RA8P1 CM33 (Core1) - IO Processor",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/renesas_evk-ra8p1-io-cm33_default/renesas_evk-ra8p1-io-cm33_default.elf",
            "armToolchainPath": "/opt/arm-gnu-toolchain-13.2.Rel1/bin",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "svdFile": "${workspaceRoot}/R7KA8P1AD.svd",
            "servertype": "jlink",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServer",
            "serverArgs": [
                "-speed", "15000"
            ],
            "device": "R7KA8P1KF_CPU1",
            "showDevDebugOutput": "parsed",
            "runToEntryPoint": "user_start",
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "rtt_1",
                        "port": 1,
                        "type": "console"
                    }
                ]
            },
            "overrideLaunchCommands": [
                "monitor reset",
                "monitor halt",
                // Enable to load the Main CM85 core binary
                //"add-symbol-file ${workspaceRoot}/build/renesas_evk-ra8p1_default/renesas_evk-ra8p1_default.elf",
                //"restore ${workspaceRoot}/build/renesas_evk-ra8p1_default/renesas_evk-ra8p1_default.bin binary 0x20000000",
                "load",
                "monitor reset",
                "monitor halt"
            ],
            "preLaunchCommands": [
                "source ${workspaceFolder}/platforms/nuttx/Debug/PX4",
                "source ${workspaceFolder}/platforms/nuttx/Debug/NuttX",
                "set mem inaccessible-by-default off",
                "set print pretty"
            ]
        }
    ]
}
