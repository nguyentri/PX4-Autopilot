# RDK-RZ/V2H CR8-0 flight-controller SIH sensor demonstration.
#
# This profile runs PX4 SIH inside the CR8-0 firmware and publishes simulated
# sensor data without initializing physical sensor, payload, or actuator
# peripherals. The board-local ROMFS mirrors only the common FC-SIH startup
# branch. control_allocator is linked for actuator metadata but is not started.

CONFIG_BOARD_ROMFSROOT="rdk-rzv2h-sih"

# No payload serial roles or RZ/V2H UART diagnostics are present.
CONFIG_BOARD_HAS_RZV_SERIAL_ICOUNT=n
CONFIG_BOARD_SERIAL_GPS1=""
CONFIG_BOARD_SERIAL_TEL1=""
CONFIG_BOARD_SERIAL_RC=""
CONFIG_BOARD_SERIAL_EXT2=""
CONFIG_COMMON_SERIAL_PORT_MAPPING=n

# Physical interfaces inherited from default.px4board are disabled.
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_UART=n

# Physical sensor, payload, and actuator drivers are disabled.
CONFIG_DRIVERS_BAROMETER=n
CONFIG_DRIVERS_BAROMETER_BMP280=n
CONFIG_DRIVERS_DSHOT=n
CONFIG_DRIVERS_GPS=n
CONFIG_DRIVERS_IMU=n
CONFIG_DRIVERS_IMU_INVENSENSE_MPU9250=n
CONFIG_DRIVERS_MAGNETOMETER=n
CONFIG_DRIVERS_PWM_OUT=n
CONFIG_DRIVERS_RC_INPUT=n
CONFIG_DRIVERS_DISTANCE_SENSOR_TFMINI=n

# Enable the FC-SIH sensor path. simulator_sih selects pwm_out_sim and the
# barometer, GPS, and magnetometer simulator modules.
CONFIG_MODULES_SIMULATION_SIMULATOR_SIH=y
CONFIG_MODULES_SIMULATION_SENSOR_AGP_SIM=n
CONFIG_MODULES_SENSORS=y
CONFIG_SENSORS_VEHICLE_AIRSPEED=n
CONFIG_SENSORS_VEHICLE_AIR_DATA=y
CONFIG_SENSORS_VEHICLE_ANGULAR_VELOCITY=y
CONFIG_SENSORS_VEHICLE_ACCELERATION=y
CONFIG_SENSORS_VEHICLE_GPS_POSITION=y
CONFIG_SENSORS_VEHICLE_MAGNETOMETER=y
CONFIG_SENSORS_VEHICLE_OPTICAL_FLOW=n

# pwm_out_sim contributes actuator output metadata. The metadata generator also
# requires exactly one mixer schema, supplied by the linked control allocator.
# The compact SIH rcS does not start control_allocator.
CONFIG_MODULES_CONTROL_ALLOCATOR=y

# Flight, payload, calibration, and persistence modules inherited from the
# default target are disabled.
CONFIG_MODULES_ATTITUDE_ESTIMATOR_Q=n
CONFIG_MODULES_COMMANDER=n
CONFIG_MODULES_DATAMAN=n
CONFIG_DATAMAN_PERSISTENT_STORAGE=n
CONFIG_MODULES_EKF2=n
CONFIG_EKF2_BAROMETER=n
CONFIG_EKF2_MAGNETOMETER=n
CONFIG_MODULES_ESC_BATTERY=n
CONFIG_MODULES_EVENTS=n
CONFIG_MODULES_FLIGHT_MODE_MANAGER=n
CONFIG_MODULES_GYRO_CALIBRATION=n
CONFIG_MODULES_LAND_DETECTOR=n
CONFIG_MODULES_LOAD_MON=n
CONFIG_MODULES_MANUAL_CONTROL=n
CONFIG_MODULES_MAVLINK=n
CONFIG_MODULES_MC_ATT_CONTROL=n
CONFIG_MODULES_MC_AUTOTUNE_ATTITUDE_CONTROL=n
CONFIG_MODULES_MC_HOVER_THRUST_ESTIMATOR=n
CONFIG_MODULES_MC_POS_CONTROL=n
CONFIG_MODULES_MC_RATE_CONTROL=n
CONFIG_MODULES_NAVIGATOR=n
CONFIG_MODULES_RC_UPDATE=n
CONFIG_MODULES_TEMPERATURE_COMPENSATION=n

# Simulation-safe diagnostics only.
CONFIG_SYSTEMCMDS_ACTUATOR_TEST=n
CONFIG_SYSTEMCMDS_DMESG=y
CONFIG_SYSTEMCMDS_I2CDETECT=n
CONFIG_SYSTEMCMDS_LED_CONTROL=n
CONFIG_SYSTEMCMDS_PARAM=y
CONFIG_SYSTEMCMDS_PERF=y
CONFIG_SYSTEMCMDS_REFLECT=n
CONFIG_SYSTEMCMDS_SERIAL_STATUS=n
CONFIG_SYSTEMCMDS_SYSTEM_TIME=y
CONFIG_SYSTEMCMDS_TOP=y
CONFIG_SYSTEMCMDS_TOPIC_LISTENER=y
CONFIG_SYSTEMCMDS_TUNE_CONTROL=n
CONFIG_SYSTEMCMDS_UORB=y
CONFIG_SYSTEMCMDS_VER=y
CONFIG_SYSTEMCMDS_WORK_QUEUE=y
