#!/bin/sh
#
# RDK-RZ/V2H safe board parameter defaults.
# Module ownership remains with the common PX4 rcS and rc.board_sensors.
#------------------------------------------------------------------------------

# The checked-in RZ/V2H reference selects the S500 quad-X airframe. Keep this
# as a default so persisted user values remain authoritative.
param set-default SYS_AUTOSTART 4014

# Pre-G9 storage is deliberately volatile; do not select an unavailable
# persistent dataman backend.
param set-default SYS_DM_BACKEND 1

# The checked-in drone reference has no active battery ADC path.
param set-default BAT1_SOURCE -1

# The board has no validated buzzer output and both payload images omit the
# tone_alarm driver. Prevent the common startup script from invoking an absent
# command while leaving tune_control event publication available.
set TONE_ALARM_START no

# Fixed payload serial assignments from the board contract.
param set-default SER_GPS1_BAUD 115200
param set-default SER_TEL1_BAUD 57600
param set-default SER_EXT2_BAUD 115200
param set-default SENS_TFMINI_CFG 401
param set-default MAV_0_RATE 4000
param set-default RC_INPUT_PROTO 2

# Probe only the explicitly configured on-board sensors.
param set-default SENS_EXT_I2C_PRB 0
param set-default SYS_HAS_BARO 1
param set-default SYS_HAS_GPS 1
param set-default SYS_HAS_MAG 1

# Four motor outputs. The silent DSHOT_MIN default also detects whether this
# image includes DShot. DShot selects DShot600; the default image selects
# standard 400 Hz PWM. Both drivers share PWM_MAIN parameters.
if param set-default -s DSHOT_MIN 0.055
then
	set DSHOT_START yes
	param set-default PWM_MAIN_TIM0 -3
	param set-default PWM_MAIN_TIM1 -3
	param set-default PWM_MAIN_TIM2 -3
	param set-default PWM_MAIN_TIM3 -3
else
	set DSHOT_START no
	param set-default PWM_MAIN_TIM0 400
	param set-default PWM_MAIN_TIM1 400
	param set-default PWM_MAIN_TIM2 400
	param set-default PWM_MAIN_TIM3 400
fi
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
param set-default PWM_MAIN_MIN1 1100
param set-default PWM_MAIN_MIN2 1100
param set-default PWM_MAIN_MIN3 1100
param set-default PWM_MAIN_MIN4 1100
param set-default PWM_MAIN_MAX1 1900
param set-default PWM_MAIN_MAX2 1900
param set-default PWM_MAIN_MAX3 1900
param set-default PWM_MAIN_MAX4 1900
param set-default PWM_MAIN_DIS1 1000
param set-default PWM_MAIN_DIS2 1000
param set-default PWM_MAIN_DIS3 1000
param set-default PWM_MAIN_DIS4 1000
param set-default PWM_MAIN_FAIL1 1000
param set-default PWM_MAIN_FAIL2 1000
param set-default PWM_MAIN_FAIL3 1000
param set-default PWM_MAIN_FAIL4 1000
