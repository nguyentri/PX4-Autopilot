  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7A7D96", "fontStyle": "italic" }
    },
    {
      "name": "Keywords & Operators",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.operator.word"],
      "settings": { "foreground": "#ED6C00", "fontStyle": "bold" }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#2E7D32" }
    },
    {
      "name": "Functions & Methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#2A3882" }
    },
    {
      "name": "Types & Classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#B35400" }
    },
    {
      "name": "Numbers & Constants",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#C25E00" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#16163F" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#424874", "fontStyle": "italic" }
    },
    {
      "name": "Tags & Markup",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#ED6C00" }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#2A3882" }
    }
  ]
}
