{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "rzv2hJlinkSerial",
            "type": "promptString",
            "description": "Exact J-Link serial number for the authorized RZ/V2H probe"
        }
    ],
    //Map usb to WSL2, run the following commands in Windows PowerShell as Administrator
    //usbipd list
    //usbipd bind --busid 1-4
    //usbipd attach --wsl --busid 1-4
    //usbipd detach --busid 1-4 // to detach the device from WSL2
    "configurations": [
        {
        "name": "@RZV_DEBUG_PROFILE_NAME@",
        "cwd": "${workspaceRoot}",
        "executable": "${workspaceRoot}/@RZV_DEBUG_EXECUTABLE@",
        "armToolchainPath": "/opt/arm-gnu-toolchain-13.2.Rel1/bin",
        "request": "attach",
        "type": "cortex-debug",
        "gdbPath": "/usr/bin/gdb-multiarch",
        "svdFile": "${workspaceRoot}/rzv2h.svd",
        "servertype": "jlink",
        "serverpath": "/opt/SEGGER/JLink/JLinkGDBServer",
        "serverArgs": [
            "-speed", "15000",
            // "-select", "IP=10.231.20.16:19023", // Need to check the IP address and Port of the JLink server
            // "-select", "IP=192.168.1.89:19023", // incase of running on wsl, need to run jlinkRemoteServer on windown
        ],
        "device": "R9A09G057H44_R8_0", // R9A09G057H44_M33_0/R9A09G057H44_R8_0
        "serialNumber": "${input:rzv2hJlinkSerial}",
        "showDevDebugOutput": "parsed",
        "rttConfig": {
            "enabled": true,
            "address": "auto",
            "decoders": [
            {
                "label": "rtt_0",
                "port": 0,
                "type": "console",
            }
            ]
        },
        "liveWatch": {
            "enabled": true,
            "samplesPerSecond": 4
        },
        "overrideAttachCommands": [
            "monitor halt"
        ],
        },
        {
            "name": "Debug RA8P1 CM85 (Core0)",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/renesas_evk-ra8p1_default/renesas_evk-ra8p1_default.elf",
            //"executable": "${workspaceRoot}/platforms/nuttx/NuttX/nuttx/nuttx",
            "armToolchainPath": "/opt/arm-gnu-toolchain-13.2.Rel1/bin",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "svdFile": "${workspaceRoot}/R7KA8P1AD.svd",
            "servertype": "jlink",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServer",
            "serverArgs": [
                "-speed", "15000"
            ],
            "device": "R7KA8P1KF_CPU0",
            "showDevDebugOutput": "parsed",
            "runToEntryPoint": "__start",
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "rtt_0",
                        "port": 0,
                        "type": "console"
                    }
                ]
            },
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "overrideLaunchCommands": [
                "monitor reset",
                "monitor halt",
                "load",
                // Enable to load the IO CM33 core binary
                //"add-symbol-file ${workspaceRoot}/build/renesas_evk-ra8p1-io-cm33_default/renesas_evk-ra8p1-io-cm33_default.elf",
                //"restore ${workspaceRoot}/build/renesas_evk-ra8p1-io-cm33_default/renesas_evk-ra8p1-io-cm33_default.bin binary 0x08000000",
                "monitor reset",
                "monitor halt"
            ],
            "preLaunchCommands": [
                "source ${workspaceFolder}/platforms/nuttx/Debug/PX4",
                "source ${workspaceFolder}/platforms/nuttx/Debug/NuttX",
                "set mem inaccessible-by-default off",
                "set print pretty"
            ]
        },
        {
            "name": "Debug RA8P1 CM33 (Core1) - IO Processor",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/renesas_evk-ra8p1-io-cm33_default/renesas_evk-ra8p1-io-cm33_default.elf",
            "armToolchainPath": "/opt/arm-gnu-toolchain-13.2.Rel1/bin",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "svdFile": "${workspaceRoot}/R7KA8P1AD.svd",
            "servertype": "jlink",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServer",
            "serverArgs": [
                "-speed", "15000"
            ],
            "device": "R7KA8P1KF_CPU1",
            "showDevDebugOutput": "parsed",
            "runToEntryPoint": "user_start",
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "rtt_1",
                        "port": 1,
                        "type": "console"
                    }
                ]
            },
            "overrideLaunchCommands": [
                "monitor reset",
                "monitor halt",
                // Enable to load the Main CM85 core binary
                //"add-symbol-file ${workspaceRoot}/build/renesas_evk-ra8p1_default/renesas_evk-ra8p1_default.elf",
                //"restore ${workspaceRoot}/build/renesas_evk-ra8p1_default/renesas_evk-ra8p1_default.bin binary 0x20000000",
                "load",
                "monitor reset",
                "monitor halt"
            ],
            "preLaunchCommands": [
                "source ${workspaceFolder}/platforms/nuttx/Debug/PX4",
                "source ${workspaceFolder}/platforms/nuttx/Debug/NuttX",
                "set mem inaccessible-by-default off",
                "set print pretty"
            ]
        }
    ]
}
