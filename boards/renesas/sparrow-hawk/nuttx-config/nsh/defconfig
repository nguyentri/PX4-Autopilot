#
# Sparrow Hawk CR52-0 configuration for PX4: the NuttX sparrow_hawk nsh base
# plus the PX4 NuttX baseline. CR52-0 owns the whole 9 MiB window
# 0x40100000-0x409FFFFF (sparrow_hawk_cr52_0_px4.ld); CR52-1 is not used.
# Console: HSCIF1 (/dev/console, /dev/ttyS0). MAVLink: HSCIF3 (/dev/ttyS1).
#
# CONFIG_DISABLE_ENVIRON is not set
# CONFIG_DISABLE_PSEUDOFS_OPERATIONS is not set
# CONFIG_DISABLE_PTHREAD is not set
# CONFIG_NSH_DISABLEBG is not set
CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD="sparrow_hawk"
CONFIG_ARCH_BOARD_SPARROW_HAWK=y
CONFIG_ARCH_CHIP="rcar"
CONFIG_ARCH_CHIP_R8A779G3=y
CONFIG_ARCH_CHIP_RCAR=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_STACKDUMP=y
CONFIG_BINFMT_DISABLE=y
CONFIG_BOARDCTL=y
CONFIG_BOARDCTL_RESET=y
CONFIG_BOARD_LOOPSPERMSEC=100000
CONFIG_BUILTIN=y
CONFIG_BUILD_FLAT=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INIT_STACKSIZE=4096
CONFIG_RAM_SIZE=9437184
CONFIG_RAM_START=0x40100000
CONFIG_RAW_BINARY=y
CONFIG_START_DAY=25
CONFIG_START_MONTH=11
CONFIG_START_YEAR=2026

# Core and window
CONFIG_RCARV4H_BUILD_CR52_0=y
CONFIG_RCARV4H_PX4_SINGLE_CORE_WINDOW=y

# Serial
CONFIG_RCAR_HSCIF1=y
CONFIG_RCAR_HSCIF3=y
CONFIG_HSCIF1_SERIAL_CONSOLE=y
CONFIG_HSCIF3_BAUD=115200
# A full MAVLink 2 FTP frame is 266 bytes; the ring reserves one slot.
CONFIG_HSCIF3_RXBUFSIZE=512
CONFIG_HSCIF3_TXBUFSIZE=512
CONFIG_SERIAL=y
CONFIG_STANDARD_SERIAL=y
CONFIG_SERIAL_TERMIOS=y
CONFIG_DEV_CONSOLE=y
CONFIG_DEV_FIFO_SIZE=0
CONFIG_DEV_PIPE_SIZE=70
CONFIG_PIPES=y

# File systems: ROMFS /etc, TMPFS /fs (parameters), procfs
CONFIG_FS_PROCFS=y
CONFIG_FS_ROMFS=y
CONFIG_FS_TMPFS=y

# C/C++ runtime
CONFIG_HAVE_CXX=y
CONFIG_HAVE_CXXINITIALIZE=y
CONFIG_LIBC_FLOATINGPOINT=y
CONFIG_LIBC_LOCALTIME=y

# NSH
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_ARCHROMFS=y
CONFIG_NSH_ROMFSETC=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_CONSOLE=y
CONFIG_NSH_DISABLE_IFUPDOWN=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_LIBRARY=y
CONFIG_NSH_LINELEN=128
CONFIG_NSH_MAXARGUMENTS=15
CONFIG_NSH_NESTDEPTH=8
CONFIG_NSH_READLINE=y
CONFIG_SYSTEM_NSH=y
CONFIG_SYSTEM_NSH_PRIORITY=100
CONFIG_SYSTEM_NSH_STACKSIZE=3072

# Scheduler
CONFIG_FDCLONE_STDIO=y
CONFIG_PREALLOC_TIMERS=50
CONFIG_PRIORITY_INHERITANCE=y
CONFIG_PTHREAD_STACK_MIN=512
# CONFIG_SCHED_BACKTRACE is not set
CONFIG_SCHED_HPWORK=y
CONFIG_SCHED_HPWORKSTACKSIZE=1800
CONFIG_SCHED_INSTRUMENTATION=y
CONFIG_SCHED_INSTRUMENTATION_EXTERNAL=y
CONFIG_SCHED_INSTRUMENTATION_SWITCH=y
CONFIG_SCHED_LPWORK=y
CONFIG_SCHED_LPWORKSTACKSIZE=2032
CONFIG_SCHED_WAITPID=y
CONFIG_SEM_PREALLOCHOLDERS=16
CONFIG_SIG_DEFAULT=y
CONFIG_SIG_SIGALRM_ACTION=y
CONFIG_SIG_SIGUSR1_ACTION=y
CONFIG_SIG_SIGUSR2_ACTION=y
CONFIG_STACK_COLORATION=y
CONFIG_TASK_NAME_SIZE=24
CONFIG_USEC_PER_TICK=1000
