#!/bin/sh
# RDK-RZ/V2H compact PWM and raw ICM20948 bench startup.
# px4_platform_init() has already initialized HRT, work queues, params and uORB.
set +e

echo ""
echo "RDK-RZ/V2H PX4 PWM + ICM20948 BENCH"
echo "PWM outputs stay disabled until an explicit finite actuator_test."
echo ""

. /etc/init.d/rc.filepaths
param select $PARAM_FILE
ver all
. /etc/init.d/rc.board_defaults

if pwm_out start
then
	echo "PWMOut start requested; verify initialization and outputs separately."
	pwm_out status
else
	echo "ERROR [init] pwm_out start failed"
fi

# Sensor startup is checked independently so either failure remains diagnosable.
. /etc/init.d/rc.board_sensors
work_queue status
