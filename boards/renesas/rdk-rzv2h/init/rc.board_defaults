#!/bin/sh
#
# Renesas RDK-RZ/V2H board defaults
#
# This file is sourced by NuttX NSH, not a POSIX shell.
#------------------------------------------------------------------------------

set RZV_DEFAULTS ${R}etc/init.d/rc.board_defaults.cmds
set RZV_CONFIG /fs/etc/config.txt
set RZV_EXTRAS /fs/etc/extras.txt
set RZV_LEGACY_DEFAULTS /fs/rc.board_defaults.cmds

# The board has status LEDs but no supported RGBLED or PX4IO hardware. Keep
# the generic startup probes disabled so absent commands are never executed.
set RGBLED_PROBE no
set PX4IO_CHECK no

# Always load the safe board defaults. Optional filesystem scripts may then
# override them with normal `param set` or `param set-default` commands.
if [ -f $RZV_DEFAULTS ]
then
	. $RZV_DEFAULTS
else
	echo "ERROR [init] missing $RZV_DEFAULTS"
fi

if [ -f $RZV_CONFIG ]
then
	echo "Board config: $RZV_CONFIG"
	. $RZV_CONFIG
fi

if [ -f $RZV_EXTRAS ]
then
	echo "Board extras: $RZV_EXTRAS"
	. $RZV_EXTRAS
fi

if [ -f $RZV_LEGACY_DEFAULTS ]
then
	echo "Legacy board defaults: $RZV_LEGACY_DEFAULTS"
	. $RZV_LEGACY_DEFAULTS
fi

unset RZV_DEFAULTS
unset RZV_CONFIG
unset RZV_EXTRAS
unset RZV_LEGACY_DEFAULTS
