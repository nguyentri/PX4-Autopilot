# Opt-in RDK drone extension; default/simple/GY912 keep their existing wiring.
# Reuse the common PX4 startup with profile-local board hooks.
CONFIG_BOARD_INIT_SUBDIR="drone"
CONFIG_BOARD_SERIAL_EXT2="/dev/ttyS4"
CONFIG_DRIVERS_IMU_INVENSENSE_MPU9250=n
CONFIG_DRIVERS_IMU_INVENSENSE_ICM20948=n
CONFIG_DRIVERS_IMU_INVENSENSE_ICM45686=y
CONFIG_DRIVERS_BAROMETER_BMP280=n
CONFIG_DRIVERS_BAROMETER_BMP388=y
CONFIG_DRIVERS_MAGNETOMETER_BOSCH_BMM150=y
CONFIG_DRIVERS_POWER_MONITOR_INA228=y
CONFIG_DRIVERS_DSHOT=n
CONFIG_BOARD_RDK_RZV2H_PX4IO_BRIDGE=n
CONFIG_BOARD_PARAM_FILE_ATOMIC=y
