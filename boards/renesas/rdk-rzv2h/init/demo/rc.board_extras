#!/bin/sh
# Apply demo streams after rc.serial has started MAVLink on SCI5.
# rc.board_mavlink runs before rc.serial and cannot configure this instance.

# CR8-1 is disabled for the single-core demo drone (no raw IPC link). To
# restore the heartbeat-only peer, re-enable CONFIG_RZV_IPC_RAW in the demo
# defconfig, the ipc_heartbeat module in src/CMakeLists.txt and these lines.
# if ! rzv2h_heartbeat start
# then
# 	echo "ERROR [init] Demo CR8-1 heartbeat failed to start"
# fi

# XRCE-DDS link to the CA55 CustomXRCEAgent over OpenAMP/RPMsg
# (rpmsg-service-1). The client retries every second until the agent has
# set DRIVER_OK and sent its handshake, so the CA55 may boot later.
if ! uxrce_dds_client start -t rpmsg -d /dev/uxrce0
then
	echo "ERROR [init] Demo CA55 uxrce_dds_client failed to start"
fi

# ADS1115 channel voltages for QGC (ADS_A0..ADS_A3 in the MAVLink Inspector).
if ! rzv2h_adc_telemetry start
then
	echo "ERROR [init] Demo ADS1115 telemetry failed to start"
fi

if ! mavlink stream -d /dev/ttyS5 -s HIGHRES_IMU -r 10
then
	echo "ERROR [init] Demo HIGHRES_IMU stream failed on SCI5"
fi

if ! mavlink stream -d /dev/ttyS5 -s SCALED_PRESSURE -r 2
then
	echo "ERROR [init] Demo SCALED_PRESSURE stream failed on SCI5"
fi

if ! mavlink stream -d /dev/ttyS5 -s DISTANCE_SENSOR -r 2
then
	echo "ERROR [init] Demo DISTANCE_SENSOR stream failed on SCI5"
fi

if ! mavlink stream -d /dev/ttyS5 -s SERVO_OUTPUT_RAW_0 -r 2
then
	echo "ERROR [init] Demo SERVO_OUTPUT_RAW_0 stream failed on SCI5"
fi

# CR8-0 <-> CR8-1 link (disabled with CR8-1): CR80-CR81 x age ms, y peer seq, z alive.
# if ! mavlink stream -d /dev/ttyS5 -s DEBUG_VECT -r 2
# then
# 	echo "ERROR [init] Demo DEBUG_VECT stream failed on SCI5"
# fi

# ADS1115 voltages: one channel per message, 10 Hz covers the 8 Hz rotation.
if ! mavlink stream -d /dev/ttyS5 -s NAMED_VALUE_FLOAT -r 10
then
	echo "ERROR [init] Demo NAMED_VALUE_FLOAT stream failed on SCI5"
fi
